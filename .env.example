# Copy to .env and set every production value before deployment.
APP_ENV=production
STORE_NAME="Hendy Store"
APP_URL=

# Generate with: openssl rand -hex 32
APP_KEY=

# Admin is created automatically on first API/health request.
# Use an address you control and a unique password with at least 12 characters (maximum 72 bytes).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Leave DB_DSN empty to use SQLite. For production on a single instance,
# mount persistent storage and set SQLITE_PATH / STORAGE_PATH accordingly.
DB_DSN=
DB_USER=
DB_PASSWORD=
SQLITE_PATH=
STORAGE_PATH=

# Large developer package upload goes directly to the private S3-compatible bucket.
# VirusTotal API v3 supports large-file upload URLs; keep this at or below 650 MiB.
MAX_DIRECT_UPLOAD_BYTES=681574400
# Keep this secret on the server only. Without it, all new releases remain blocked from publication.
VIRUSTOTAL_API_KEY=
# Future signing-provider integration; not active until a dedicated HSM/Key Vault adapter is deployed.
CODE_SIGNING_SERVICE_URL=
CODE_SIGNING_SERVICE_TOKEN=

# Legacy PHP-only registration remains disabled.
ALLOW_REGISTRATION=false
# Customer sign-up through Neon Auth (email verification remains mandatory).
NEON_AUTH_PUBLIC_SIGNUP=false
# Public Neon Data API endpoint; never add a Neon API key or DB credentials here.
NEON_DATA_API_URL=
# Show Google sign-in only after a production OAuth client is configured in Neon Auth.
GOOGLE_OAUTH_ENABLED=false
FORCE_SECURE_COOKIES=true
FORCE_HTTPS=true
# Set true only when hosted behind a trusted reverse proxy (e.g. Render).
TRUST_PROXY_HEADERS=false

# Optional public support contact; publish the same contact on Legal Notice.
STORE_CONTACT_EMAIL=

# SePay credentials are intentionally blank; Paid checkout stays disabled until configured.
# No payment provider is configured or used.
